<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
    <!-- The support of the connector tests is that of the common tests (which have it already). -->
    <Compile Include="$(MSBuildThisFileDirectory)Binance.Common.Tests/Support/*.cs" LinkBase="Support"
             Condition="'$(MSBuildProjectName)' != 'Binance.Common.Tests'" />
  </ItemGroup>
</Project>
