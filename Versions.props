    <Version Condition="'$(MSBuildProjectName)' == 'Binance.VipLoan'">1.0.0</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Binance.W3WPrediction'">1.0.0</Version>
    <Version Condition="'$(MSBuildProjectName)' == 'Binance.Wallet'">1.0.0</Version>
